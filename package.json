{
  "name": "ticket-c2c-platform",
  "version": "0.1.0",
  "private": true,
  "description": "C2C ticket platform architecture and local PoC workspace.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node src/main.ts",
    "poc:inventory": "ts-node --project tsconfig.scripts.json scripts/poc/inventory-purchase-poc.ts",
    "start:worker": "node dist/src/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "commitlint": "commitlint",
    "lint:md": "markdownlint-cli2",
    "test": "jest",
    "test:migration:ticket-type-expand": "jest src/database/migrations/1785128190273-add-ticket-type-expand-schema.spec.ts --runInBand",
    "test:migration:ticket-type-compatibility": "jest src/database/migrations/1785542400000-add-ticket-type-compatibility-writer.spec.ts --runInBand",
    "test:integration:search-projection": "jest src/search/projection.integration.spec.ts --runInBand",
    "test:integration:cutover": "jest src/cutover/cutover-readiness.integration.spec.ts --runInBand",
    "test:integration:writer-mode-switch": "jest src/cutover/writer-mode-switch.integration.spec.ts --runInBand",
    "cutover:check": "node dist/src/cutover/check-ticket-type-cutover-readiness.js",
    "cutover:check:local": "ts-node src/cutover/check-ticket-type-cutover-readiness.ts",
    "cutover:switch": "node dist/src/cutover/switch-ticket-type-writer-mode.js",
    "cutover:switch:local": "ts-node src/cutover/switch-ticket-type-writer-mode.ts",
    "projection:reconcile": "node dist/src/search/inventory-reconciliation.cli.js",
    "projection:reconcile:local": "ts-node src/search/inventory-reconciliation.cli.ts",
    "projection:rebuild": "node dist/src/search/inventory-rebuild.cli.js",
    "projection:rebuild:local": "ts-node src/search/inventory-rebuild.cli.ts",
    "projection:repair": "node dist/src/search/projection-repair.cli.js",
    "projection:repair:local": "ts-node src/search/projection-repair.cli.ts",
    "search-index:migrate": "node dist/src/search/search-index-migrate.cli.js",
    "search-index:migrate:local": "ts-node src/search/search-index-migrate.cli.ts",
    "smoke:staging": "ts-node --project tsconfig.scripts.json scripts/staging/smoke-test.ts",
    "smoke:dev": "ts-node --project tsconfig.scripts.json scripts/staging/smoke-test.ts",
    "migration:run": "node dist/src/database/run-migrations.js",
    "migration:run:local": "ts-node src/database/run-migrations.ts",
    "migration:check:ticket-type-expand": "ts-node src/database/check-ticket-type-expand-readiness.ts",
    "migration:check:ticket-type-expand:prod": "node dist/src/database/check-ticket-type-expand-readiness.js",
    "migration:create": "typeorm migration:create"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1096.0",
    "@aws-sdk/client-secrets-manager": "^3.1084.0",
    "@aws-sdk/client-sqs": "^3.1104.0",
    "@aws-sdk/credential-provider-node": "^3.972.78",
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@opensearch-project/opensearch": "^3.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.75.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.9.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "jest": "^30.4.2",
    "markdownlint-cli2": "^0.23.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "find-my-way": "9.7.0"
  }
}
